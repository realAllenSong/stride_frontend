# Default: authored public examples only. Set gateway before loading real data.
STRIDE_AUTH_MODE=demo
# Server-readable approved Workspace JSON. Never include raw/private records.
# STRIDE_WORKSPACE_FILE=/run/stride/workspace.json
# Public verification key in SPKI PEM format; never put a signing key here.
# STRIDE_JWT_PUBLIC_KEY_FILE=/run/stride/gateway-public.pem
# Exact token issuer and audience expected from the company identity gateway.
# STRIDE_JWT_ISSUER=https://identity.example.com
# STRIDE_JWT_AUDIENCE=stride
# Server-owned mapping of identity subjects to project/group access grants.
# STRIDE_ACCESS_POLICY_FILE=/run/stride/access-policy.json
